{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "forge": {
      "type": "string",
      "enum": ["gitea", "github"]
    },
    "opencode": {
      "type": "object",
      "properties": {
        "wellKnownUrl": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "codex": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "urlKey": { "type": "string" }
      }
    },
    "router": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 1, "maximum": 1 },
        "podLabels": { "type": "object" },
        "podAnnotations": { "type": "object" }
      }
    },
    "control": {
      "type": "object",
      "properties": {
        "dispatchEngine": { "type": "boolean" },
        "dispatchWorker": { "type": "boolean" },
        "engineMaxJobs": { "type": "integer", "minimum": 1 },
        "workerMaxJobs": { "type": "integer", "minimum": 1 },
        "podLabels": { "type": "object" },
        "podAnnotations": { "type": "object" }
      }
    },
    "jobs": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "object",
          "properties": {
            "forgeTokenSecret": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "key": { "type": "string" }
              }
            },
            "initContainers": { "type": "array" },
            "volumeClaimLabels": { "type": "object" },
            "volumeClaimAnnotations": { "type": "object" }
          }
        },
        "worker": {
          "type": "object",
          "properties": {
            "forgeTokenSecret": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "key": { "type": "string" }
              }
            },
            "initContainers": { "type": "array" },
            "volumeClaimLabels": { "type": "object" },
            "volumeClaimAnnotations": { "type": "object" }
          }
        }
      }
    },
    "containerSecurityContext": {
      "type": "object",
      "properties": {
        "readOnlyRootFilesystem": { "type": "boolean" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  }
}
