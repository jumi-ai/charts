{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "forge": {
      "type": "string",
      "enum": ["gitea", "github"]
    },
    "opencode": {
      "type": "object",
      "properties": {
        "wellKnownUrl": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "codex": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "router": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 1, "maximum": 1 }
      }
    },
    "control": {
      "type": "object",
      "properties": {
        "dispatchEngine": { "type": "boolean" },
        "dispatchWorker": { "type": "boolean" },
        "engineMaxJobs": { "type": "integer", "minimum": 1 },
        "workerMaxJobs": { "type": "integer", "minimum": 1 }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  }
}
