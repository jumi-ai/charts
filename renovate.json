{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignorePresets": ["mergeConfidence:age-confidence-badges"],
  "prCreation": "immediate",
  "addLabels": ["jumi", "ignore-conflicts"],
  "minimumReleaseAge": "3 days",
  "automerge": false,
  "platformAutomerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Helm CLI version in the CI install script. One download location, so the bump moves every job in one pull.",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/", "/^scripts\\/install-helm\\.sh$/"],
      "matchStrings": [
        "https://get\\.helm\\.sh/helm-(?<currentValue>v\\d+\\.\\d+\\.\\d+)-linux-amd64\\.tar\\.gz"
      ],
      "depNameTemplate": "helm",
      "packageNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "actionlint version in the lint job.",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["ACTIONLINT_VERSION:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "actionlint",
      "packageNameTemplate": "rhysd/actionlint",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "ShellCheck binary version used by the lint job.",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["SHELLCHECK_VERSION:\\s*v(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "shellcheck",
      "packageNameTemplate": "koalaman/shellcheck",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "zizmor version in the lint job.",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["ZIZMOR_VERSION:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "zizmor",
      "packageNameTemplate": "zizmor",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "kind CLI version in the e2e download URLs. Both mirrors move in one pull.",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "https://kind\\.sigs\\.k8s\\.io/dl/(?<currentValue>v\\d+\\.\\d+\\.\\d+)/kind-linux-amd64",
        "https://github\\.com/kubernetes-sigs/kind/releases/download/(?<currentValue>v\\d+\\.\\d+\\.\\d+)/kind-linux-amd64"
      ],
      "depNameTemplate": "kind",
      "packageNameTemplate": "kubernetes-sigs/kind",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "kindest/node image tag in the e2e cluster step. Pinned to the chart kubeVersion floor; only patch updates.",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["kindest/node:v(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "kindest/node",
      "packageNameTemplate": "kindest/node",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "kindest/node stays on the chart's kubeVersion floor (1.30). Only patch updates, so the e2e keeps testing the oldest supported Kubernetes.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["kindest/node"],
      "allowedVersions": "/^1\\.30\\./"
    },
    {
      "description": "Actions stay pinned to a commit with a version comment.",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "pinDigests": true
    },
    {
      "description": "Chart values are what an install pulls and only change with a signed chart tag. Do not pin a digest into them.",
      "matchManagers": ["helm-values"],
      "pinDigests": false
    },
    {
      "description": "Same contract by update type: no pin, digest pin, or digest bump pull against chart values.",
      "matchManagers": ["helm-values"],
      "matchUpdateTypes": ["pin", "pinDigest", "digest"],
      "enabled": false
    },
    {
      "description": "Reviewer and worker tags are empty on purpose: the install uses v plus Chart.appVersion. A human moves them with a tested chart release.",
      "matchPackageNames": ["/(^|/)jumi-(reviewer|worker)$/"],
      "enabled": false
    },
    {
      "description": "Bundled Postgres floats on 18-alpine. Stay on the 18 line.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres"],
      "allowedVersions": "/^18([.-]|$)/"
    }
  ]
}
